@baseUrl = http://127.0.0.1:8080

# 이 파일 옆에 posting.png를 두고 실행한다.
# 접수 뒤 Retry-After 헤더 간격으로 작업 상태를 조회한다.

### 첨부 공고 이미지 구조화 접수
# @name enqueueAttachment
POST {{baseUrl}}/api/postings/import-image
Content-Type: multipart/form-data; boundary=janovel-posting-image

--janovel-posting-image
Content-Disposition: form-data; name="image"; filename="posting.png"
Content-Type: image/png

< ./posting.png
--janovel-posting-image--

?? status == 202
?? header location startsWith /api/postings/import-jobs/
?? body status == QUEUED

### 첨부 이미지 구조화 상태 조회
# @name getAttachmentJob
# @ref enqueueAttachment
GET {{baseUrl}}/api/postings/import-jobs/{{enqueueAttachment.jobId}}

?? status == 200
?? body status matches ^(QUEUED|PROCESSING|COMPLETED|FAILED)$
